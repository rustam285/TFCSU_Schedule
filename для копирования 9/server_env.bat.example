@echo off
rem Шаблон настроек сервера. Скопируй этот файл в server_env.bat и заполни.
rem server_env.bat НЕ коммитится (в .gitignore) и хранится только на сервере.
rem Именно отсюда запуск_сервера.bat берёт переменные окружения: переменные,
rem заданные через setx, НЕ видны процессам, запущенным планировщиком от SYSTEM,
rem из-за чего сайт раньше стартовал без секретного ключа ("Session data corrupted").

rem Секретный ключ Django. Сгенерировать новый:
rem   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
set DJANGO_SECRET_KEY=ВСТАВЬ_СЮДА_СГЕНЕРИРОВАННЫЙ_КЛЮЧ

rem Прод-режим: DEBUG обязательно False
set DJANGO_DEBUG=False

rem Хосты, по которым открывают сайт (через запятую, без пробелов)
set DJANGO_ALLOWED_HOSTS=tfcsu.ru,localhost,127.0.0.1

rem Настройки парсера (обычно не нужны - значения по умолчанию серверные)
rem set PARSER_HOST=192.168.2.250
rem set PARSER_PORT=8001
